{
  "version": 1,
  "page": {
    "size": "A6",
    "orientation": "Portrait",
    "margin_mm": 5
  },
  "blocks": [
    {
      "id": "logo",
      "type": "image",
      "position": "absolute",
      "x_mm": 0.0,
      "y_mm": 0.0,
      "width_mm": 25.0,
      "height_mm": 20.0,
      "z_index": -100,
      "repeat": "first_page",
      "overflow": "clip",
      "spacing_after": 4.0,
      "fieldname": "print_template.template_logo"
    },
    {
      "id": "business_name",
      "type": "text",
      "visible": true,
      "alignment": "center",
      "font_size": 15.0,
      "bold": true,
      "position": "flow",
      "spacing_after": 2.0,
"margin":"10 0 0 0",
      "z_index": 100,
      "text": "{{business_name_kh}}\n{{business_name_en}}"
    },
    {
      "id": "invoice_title",
      "type": "text",
      "visible": true,
      "alignment": "center",
      "font_size": 20.0,
      "bold": true,
      "position": "flow",
      "spacing_after": 4.0,
      "text": "វិកយប័ត្រ"
    },
    {
  "id": "contact_and_sale_row",
  "type": "row",
  "visible": true,
  "position": "flow",
  "gap_mm": 3,
  "margin": "0 2 0 2",
  "padding": "2 2 2 2",
  "spacing_after": 4,
  "children": [
    {
      "id": "business_contact",
      "type": "text",
      "visible": true,
      "alignment": "left",
      "font_size": 9,
      "bold": false,
      "flex": 1,
      "spacing_after": 0,
      "text": "{{address}}\n{{phone_number_1}}"
    },
    {
  "id": "sale_info",
  "type": "column",
  "visible": true,
  "position": "flow",
  "gap_mm": 1,
  "spacing_after": 4,
  "children": [
    {
      "id": "invoice_row",
      "type": "row",
      "gap_mm": 2,
      "spacing_after": 0,
      "children": [
        {
          "id": "invoice_label",
          "type": "text",
          "text": "លេខ:",
          "flex": 1,
          "font_size": 9,
          "bold": true,
          "spacing_after": 0
        },
        {
          "id": "invoice_value",
          "type": "text",
          "fieldname": "sale.name",
          "flex": 1,
          "font_size": 9,
          "spacing_after": 0
        }
      ]
    },
    {
      "id": "posting_date_row",
      "type": "row",
      "gap_mm": 2,
      "spacing_after": 0,
      "children": [
        {
          "id": "posting_date_label",
          "type": "text",
          "text": "កាលបរិច្ឆេទ:",
          "flex": 1,
          "font_size": 9,
          "bold": true,
          "spacing_after": 0
        },
        {
          "id": "posting_date_value",
          "type": "date",
          "fieldname": "sale.posting_date",
          "flex": 1,
          "font_size": 9,
          "spacing_after": 0
        }
      ]
    },
    {
      "id": "seller_row",
      "type": "row",
      "gap_mm": 2,
      "spacing_after": 0,
      "children": [
        {
          "id": "seller_label",
          "type": "text",
          "text": "អ្នកលក់:",
          "flex": 1,
          "font_size": 9,
          "bold": true,
          "spacing_after": 0
        },
        {
          "id": "seller_value",
          "type": "text",
          "fieldname": "seller",
          "flex": 1,
          "font_size": 9,
          "spacing_after": 0
        }
      ]
    }  ]
}
  ]
},
      {
      "id": "customer_info",
      "type": "customer_info",
      "visible": true,
      "alignment": "left",
      "font_size": 10.0,
      "bold": true,
      "position": "flow",
      "spacing_after": 4.0
    },
    {
      "id": "product_table",
      "type": "product_table",
      "visible": true,
      "alignment": "left",
      "font_size": 9.0,
      "bold": false,
      "position": "flow",
      "spacing_after": 4.0
    },
    {
      "id": "barcode",
      "type": "barcode",
      "visible": true,
      "alignment": "left",
      "font_size": 9.0,
      "bold": false,
      "position": "flow",
      "spacing_after": 4.0
    },
    {
      "id": "totals",
      "type": "totals",
      "visible": true,
      "alignment": "left",
      "font_size": 9.0,
      "bold": false,
      "position": "flow",
      "spacing_after": 4.0
    },
    {
      "id": "notes",
      "type": "notes",
      "visible": true,
      "alignment": "left",
      "font_size": 9.0,
      "bold": false,
      "position": "flow",
      "spacing_after": 4.0
    },
    {
      "id": "signatures",
      "type": "signatures",
      "visible": true,
      "alignment": "left",
      "font_size": 9.0,
      "bold": false,
      "position": "flow",
      "spacing_after": 4.0
    }
  ]
}